menu "RSS Display Configuration"

config WIFI_AP_SSID
    string "WiFi AP SSID"
    default "ESP32-Config"
    help
        SSID for the WiFi AP mode (config portal).

config WIFI_AP_PASSWORD
    string "WiFi AP Password"
    default "12345678"
    help
        Password for the WiFi AP mode. Must be at least 8 characters.

config WIFI_CONNECT_TIMEOUT_SEC
    int "WiFi connection timeout (seconds)"
    default 60
    range 10 300
    help
        Timeout for WiFi connection in STA mode.

config FIRMWARE_VERSION
    int "Firmware version"
    default 1
    help
        固件发布版本，仅用于显示，不影响持久化配置。

config BACKEND_BASE_URL
    string "Backend API base URL"
    default "http://192.168.3.122:8080"
    help
        后端根地址，设备会自动生成内容与评分 API 路径。

config DEVICE_ID
    string "Device ID override"
    default ""
    help
        留空表示首次启动时由芯片 MAC 生成唯一标识（例如 esp32s3-a1b2c3d4e5f6）
        并随配置保存，多台设备不会共用同一测试身份。
        填写后作为显式覆盖，已保存的显式标识不会被固件自动修改。

endmenu
