# ESP32-S3 板级配置（PlatformIO 构建时自动合并到 sdkconfig.defaults，后者优先）
# 该文件仅覆盖 esp32s3 与 esp32 - 的差异项

# 主任务栈：app_main 在 AP 配网模式下会直接循环驱动 LVGL 渲染
# （main.cpp 中 ui_animation_task() + lv_timer_handler）。
# IDF 默认 3584 字节不足以完成 LVGL 9.6 软件圆角抗锯齿绘制，实测会触发
# "stack overflow in task main" 并反复重启，故提到与 image_display_task 一致的 8KB。
# （esp32c3 环境通过 sdkconfig.defaults 共用同款配置）
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Flash 容量：ESP32-S3 模组为 8MB，与 esp32-s3-devkitc-1 板型声明保持一致，
# 否则 PlatformIO 会报 "Flash memory size mismatch"。
# 分区表末端约 0x290000（2.7MB），8MB 容量有充足余量。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# 设备标识：S3 设备使用独立 ID，便于后端区分设备
# CONFIG_DEVICE_ID="esp32s3-rss-001"