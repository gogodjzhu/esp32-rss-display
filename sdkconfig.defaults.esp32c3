# ESP32-C3 板级配置（PlatformIO 构建时自动合并到 sdkconfig.defaults，后者优先）
# 该文件无需手动维护完整配置，仅覆盖 esp32c3 与 esp32 - 的差异项

# C3 常规为 4MB flash（airm2m_core_esp32c3 板定义），与 platformio.ini 中
# board_upload.flash_size = 4MB 保持一致，否则烧录报 "Flash memory size mismatch"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# C3 单核 RISC-V，默认 160MHz（无需强制 240MHz，C3 不支持）
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# 设备标识：C3 设备使用独立 ID，便于后端区分设备
# CONFIG_DEVICE_ID="esp32c3-rss-001"